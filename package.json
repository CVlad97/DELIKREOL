{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-spa-route-copies.mjs && echo \"delikreol.com\" > dist/CNAME && touch dist/.nojekyll",
    "lint": "eslint .",
    "preview": "npm run build && vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "check:env": "node scripts/check-env.cjs",
    "sequence:status": "node scripts/sequence-status.cjs",
    "audit:routes": "node scripts/audit-routes.cjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:links": "node scripts/audit-http.cjs",
    "audit:all": "npm run typecheck && npm run build && npm run audit:links",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "partners:sync:dry": "node scripts/partners-sync.mjs --dry-run",
    "partners:sync:apply": "node scripts/partners-sync.mjs --apply",
    "partners:sql": "node scripts/partners-sync.mjs --sql",
    "partners:sql:write": "node scripts/partners-sync.mjs --sql > supabase/seed.partners.sql",
    "test:supabase": "vitest run tests/supabase",
    "deploy": "npm run build && wrangler deploy",
    "prepare": "husky",
    "supabase:link": "supabase link --project-ref boihlgodmclljtckhmgz",
    "supabase:deploy:functions": "supabase functions deploy checkout-order create-checkout-session create-payment-intent --project-ref boihlgodmclljtckhmgz --use-api",
    "supabase:deploy:checkout": "supabase functions deploy checkout-order create-checkout-session create-payment-intent --project-ref boihlgodmclljtckhmgz --use-api"
  },
  "dependencies": {
    "@blinkdotnew/react": "^1.0.2",
    "@blinkdotnew/sdk": "^2.3.5",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/supabase-js": "^2.57.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "i18next": "^26.3.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.344.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.9",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.13.0",
    "stripe": "^19.3.1",
    "tailwind-merge": "^3.5.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.1",
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.60.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.8",
    "adbkit": "^2.11.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.3.0",
    "lint-staged": "^17.0.8",
    "postcss": "^8.4.35",
    "supabase": "^2.109.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.8",
    "wrangler": "^4.99.0"
  }
}
